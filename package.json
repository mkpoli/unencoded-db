    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/bun": "^1.2.0",
    "@types/d3-contour": "^3.0.6",
    "@types/opentype.js": "^1.3.10",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "d3-contour": "^4.0.3",
    "fflate": "^0.8.3",
    "fonteditor-core": "^2.6.3",
    "han-compose": "github:mkpoli/han-compose#1cbf35942fa10f742e40b85fc7fbd4547aac5b6d",
