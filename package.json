{
  "name": "unencoded-db",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "bun run build && wrangler dev --local --infer-origin-from-routes=false",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && bun test ./src",
    "db:local": "wrangler d1 migrations apply DB --local && bun scripts/sweep-source-names.ts --local && bun scripts/sweep-publishers.ts --local && bun scripts/sweep-dates.ts --local && bun scripts/sweep-title-readings.ts --local && bun scripts/sweep-forms.ts --local",
    "postinstall": "node scripts/prepare-composer.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260819.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/bun": "^1.2.0",
    "@types/d3-contour": "^3.0.6",
    "@types/kuromoji": "0.1.3",
    "@types/opentype.js": "^1.3.10",
    "koconv": "0.4.0",
    "kuromoji": "0.1.2",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "wanakana": "5.3.1",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@hyzyla/pdfium": "3.0.0",
    "@jsquash/webp": "1.5.0",
    "@resvg/resvg-wasm": "2.6.2",
    "d3-contour": "^4.0.3",
    "fast-png": "8.0.0",
    "fflate": "^0.8.3",
    "fonteditor-core": "^2.6.3",
    "han-compose": "github:mkpoli/han-compose#4595fd3e1f8b2498fdefead001b57c9c5e1044bb",
    "ids-input": "github:mkpoli/ids-input#722e45f1a42a90bb5586719cef232bf0d7930a4f",
    "jose": "^6.2.15",
    "opentype.js": "1.3.4",
    "svgpath": "^2.6.0"
  },
  "patchedDependencies": {
    "fonteditor-core@2.6.3": "patches/fonteditor-core@2.6.3.patch"
  }
}
