{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unencoded-db",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "vars": { "NEW_RECORDS_PAUSED": "1" },
  "d1_databases": [{ "binding": "DB", "database_name": "unencoded-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "CONTRIBUTION_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
