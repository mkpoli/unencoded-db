{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unencoded-db",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "vars": { "NEW_RECORDS_PAUSED": "1" },
  "routes": [{ "pattern": "rare.glyphatlas.org", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "unencoded-db", "database_id": "5eb47628-085d-4a4f-a506-b927ed331de4", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "unencoded-db-images" }],
  "ratelimits": [{ "name": "CONTRIBUTION_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
